{
  "name": "cyberwiki-hub",
  "version": "5.0.0",
  "description": "CyberWiki Hub - Enciclopedia de Ciberseguridad #1 en Español",
  "type": "module",
  "main": "src/main.js",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "lint": "eslint src/ --ext .js",
    "lint:fix": "eslint src/ --ext .js --fix",
    "format": "prettier --write \"src/**/*.js\"",
    "typecheck": "tsc --noEmit",
    "test": "vitest",
    "test:run": "vitest run",
    "test:coverage": "vitest run --coverage",
    "cap:sync": "npx cap sync",
    "cap:android": "npx cap open android",
    "analyze": "vite build --mode analyze"
  },
  "keywords": [
    "ciberseguridad",
    "cybersecurity",
    "wiki",
    "knowledge-base",
    "owasp",
    "mitre-attack",
    "pentesting"
  ],
  "author": "CyberWiki Hub",
  "license": "MIT",
  "dependencies": {
    "@capacitor/android": "^8.4.2",
    "@capacitor/app": "^8.1.1",
    "@capacitor/cli": "^8.4.2",
    "@capacitor/core": "^8.4.2",
    "@capacitor/haptics": "^8.0.2",
    "@capacitor/keyboard": "^8.0.5",
    "@capacitor/status-bar": "^8.0.3"
  },
  "devDependencies": {
    "@vitest/coverage-v8": "^3.2.1",
    "eslint": "^9.28.0",
    "jsdom": "^30.0.1",
    "prettier": "^3.5.3",
    "prismjs": "^1.30.0",
    "terser": "^5.39.0",
    "typescript": "^5.8.3",
    "vite": "^6.4.3",
    "vitest": "^3.2.1"
  },
  "engines": {
    "node": ">=18.0.0",
    "npm": ">=9.0.0"
  },
  "browserslist": [
    ">0.2%",
    "not dead",
    "not ie 11",
    "not op_mini all"
  ]
}
